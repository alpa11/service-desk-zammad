# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/maintenance
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintenance
DB_USER=user
DB_PASSWORD=password

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=24h

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
